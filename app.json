{
  "expo": {
    "name": "Human by Design",
    "slug": "human-by-design",
    "version": "1.0.0",
    "scheme": "humanbydesign",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "global.humanbydesign.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "global.humanbydesign.app",
      "adaptiveIcon": {
        "backgroundColor": "#1C1511",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Human by Design",
      "backgroundColor": "#FBF7F1",
      "themeColor": "#1C1511"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#1C1511"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/app"
    },
    "extra": {
      "askUrl": "https://humanbydesign.global/.netlify/functions/ask",
      "revenuecat": {
        "ios": "",
        "android": ""
      },
      "eas": {
        "projectId": "33494578-2dd4-409b-924c-e2f84ee904bf"
      }
    },
    "owner": "human-by-design",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}